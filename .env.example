# Example environment variables (copy to .env for local run; do NOT commit .env)
# For Docker Compose, use secrets instead: .secrets/github_token and .secrets/webhook_secret

# GITHUB_TOKEN=your_github_personal_access_token
# WEBHOOK_SECRET=your_webhook_secret
CODDY_PORT=8088

# Optional overrides
# BOT_REPOSITORY=EvilFreelancer/coddy
# WEBHOOK_PORT=8000
# BOT_IDLE_MINUTES=10   # Minutes of no activity before planner posts (default 10)
# OBSERVER_SYNC_ON_STARTUP=true   # Fetch issues and PRs from API into .coddy/ on observer start
# CURSOR_CLI_TIMEOUT=600   # Agent run timeout in seconds (default 600)
REPO_PATH=.
